<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flmap_accumulator</name>
  <version>0.1.0</version>
  <description>
    PC-side map accumulator. Merges the streamed per-frame clouds into a growing map
    (/flmap/map) so the remote RViz shows an accumulating map without extra bandwidth.
  </description>
  <maintainer email="cj126050@users.noreply.github.com">FLMap.2 contributors</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
